# UI parity subset (pipeline, palette, file pickers, measurements, element picker).
theme light
open rust/tests/fixtures/tour/CuNi-L12.cif
reset-view
notify
wait 12
pipeline open
pipeline text replicate 2 1 1 | select-expression fz > 0.5 | assign-element Al | wrap
pipeline disable 4
wait 12
screenshot tmp/rust-tour-f2/10-pipeline-panel.png
pipeline dock
wait 12
screenshot tmp/rust-tour-f2/11-pipeline-docked.png
pipeline undock
wait 12
screenshot tmp/rust-tour-f2/12-pipeline-undocked.png
close-windows
pipeline discard
command file open
wait 12
screenshot tmp/rust-tour-f2/19-open-file.png
close-windows
command Export Image
wait 12
screenshot tmp/rust-tour-f2/20-export-image.png
close-windows
select-atoms 0 1
measure distance
wait 12
screenshot tmp/rust-tour-f2/52-measure-distance.png
select-atoms 0 1 2
measure angle
wait 12
screenshot tmp/rust-tour-f2/53-measure-angle.png
select-atoms 0 1 2 3
measure dihedral
wait 12
screenshot tmp/rust-tour-f2/54-measure-dihedral.png
clear-selection
close-windows
palette
wait 12
screenshot tmp/rust-tour-f2/63-command-palette.png
close-windows
palette lattice
wait 12
screenshot tmp/rust-tour-f2/64-command-palette-search.png
close-windows
command Keyboard Shortcuts
wait 12
screenshot tmp/rust-tour-f2/65-shortcuts.png
close-windows
theme dark
pipeline open
pipeline text replicate 2 1 1 | select-expression fz > 0.5 | assign-element Al | wrap
pipeline disable 4
wait 12
screenshot tmp/rust-tour-f2/69-dark-pipeline-panel.png
quit
