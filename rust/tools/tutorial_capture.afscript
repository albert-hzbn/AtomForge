# The manual's tutorial screenshots (the C++ ATOMFORGE_TUTORIAL_CAPTURE,
# ui/TutorialCapture.cpp): each image is the whole window, with the bounds of
# what it shows written to FOLDER/bounds-rust.json. Run from
# docs/manual/examples (the file browser shows that folder):
#   cd docs/manual/examples
#   ATOMFORGE_UI_SCRIPT=../../../rust/tools/tutorial_capture.afscript ../../../rust/target/release/AtomForge
#   python ../scripts/update_tutorial_captures.py ../../../tmp/tutorial-capture
capture-folder ../../../tmp/tutorial-capture
theme light
wait 12
open cu_host.cif
reset-view
notify
wait 12
# Menus.
menu View
wait 12
capture tutorials/view-menu.jpg menus
close-windows
wait 3
menu View > Atom Style
wait 12
capture tutorials/atom-representation.jpg menus
close-windows
wait 3
menu View > Colour Atoms By
wait 12
capture tutorials/structure-colouring.jpg menus
close-windows
wait 3
menu View > Theme
wait 12
capture tutorials/theme-options.jpg menus
close-windows
wait 3
menu Edit
wait 12
capture tutorials/edit-menu.jpg menus
close-windows
wait 3
menu Build
wait 12
capture tutorials/build-menu.jpg menus
close-windows
wait 3
menu Settings > Interface Size
wait 12
capture tutorials/interface-size.jpg menus
close-windows
# Builders.
bulk open
wait 12
capture tutorials/bulk-controls.jpg popups
capture bulk-dialog.png popups
bulk systems
wait 12
capture tutorials/bulk-systems.jpg popups
close-windows
dialog build-sss open
dialog build-sss use-scene
wait 20
capture tutorials/alloy-controls.jpg popups
select-atoms 0
element-picker open substitute
element-picker type ni
wait 12
capture tutorials/element-picker.jpg top
close-windows
clear-selection
dialog build-amorphous open
dialog build-amorphous elements Si 64; O 128
dialog build-amorphous density 2.2
wait 12
capture tutorials/amorphous-controls.jpg popups
dialog build-amorphous mindist O Si 1.5
wait 12
capture tutorials/amorphous-advanced.jpg popups
dialog build-amorphous box 20 20 20
wait 12
capture tutorials/amorphous-manual.jpg popups
close-windows
dialog build-poly open
wait 12
capture tutorials/polycrystal-controls.jpg popups
dialog build-poly reference cu_fcc.cif
wait 20
capture tutorials/polycrystal-loaded.jpg popups
try dialog build-poly mode specified
wait 12
capture tutorials/polycrystal-modes.jpg popups
try dialog build-poly mode random
close-windows
dialog build-gb open
dialog build-gb load cu_fcc.cif
dialog build-gb axis 0 0 1
try dialog build-gb find
wait 40
capture tutorials/csl-loaded.jpg popups
capture tutorials/csl-options.jpg popups
close-windows
dialog build-custom open
dialog build-custom load cu_fcc.cif
dialog build-custom load octahedron.obj
dialog build-custom scale 12
wait 30
capture tutorials/custom-loaded.jpg popups
try dialog build-custom orientation euler 0 0 0
wait 12
capture tutorials/custom-euler.jpg popups
try dialog build-custom orientation miller 1 0 0
wait 12
capture tutorials/custom-miller.jpg popups
try dialog build-custom orientation off
try dialog build-custom build
close-windows
reset-view
wait 40
notify
wait 2
capture tutorials/custom-result.jpg viewport
close-all
open cu_host.cif
reset-view
dislocation open
wait 30
capture tutorials/dislocation-controls.jpg popups
try dislocation generate
wait 60
capture tutorials/dislocation-preview.jpg popups
capture tutorials/dislocation-summary.jpg popups
close-windows
dialog insert-interstitials open
dialog insert-interstitials use-scene
wait 20
capture tutorials/interstitial-detection.jpg popups
try dialog insert-interstitials detect
wait 60
capture tutorials/interstitial-voids.jpg popups
capture tutorials/interstitial-placement.jpg popups
capture tutorials/interstitial-modes.jpg popups
capture tutorials/interstitial-mesh.jpg popups
close-windows
dialog build-sculpt open
dialog build-sculpt use-scene
dialog build-sculpt add 1 0 0
dialog build-sculpt slab 1 periodic on
wait 30
capture tutorials/sculptor-periodic.jpg popups
dialog build-sculpt slab 1 periodic off
wait 20
capture tutorials/sculptor-manual.jpg popups
close-windows
dialog build-nano open
wait 12
capture tutorials/nano-controls.jpg popups
dialog build-nano reference cu_fcc.cif
dialog build-nano mode wulff
dialog build-nano facets 1 0 0 1.0; 1 1 1 0.9; 1 1 0 1.1
dialog build-nano wulff-radius 20
wait 40
capture tutorials/wulff-loaded.jpg popups
close-all
dialog build-nano open
try dialog build-nano build
wait 60
capture tutorials/wulff-built.jpg popups
close-windows
reset-view
wait 30
notify
wait 2
capture tutorials/wulff-result.jpg viewport
dialog merge open
wait 20
capture tutorials/merge-controls.jpg popups
close-windows
close-all
open cu_host.cif
reset-view
dialog supercell open
wait 12
capture tutorials/transform-controls.jpg popups
close-windows
# Edit and display settings.
dialog add-atom open
wait 12
capture tutorials/edit-structure.jpg popups
close-windows
settings sizes
wait 12
capture tutorials/atomic-sizes.jpg popups
settings close
settings tab style
wait 12
capture tutorials/display-style.jpg popups
settings tab lighting
wait 12
capture tutorials/display-lighting.jpg popups
settings tab atoms
wait 12
capture tutorials/display-atoms.jpg popups
settings close
settings preset Publication
wait 20
capture tutorials/display-publication.jpg viewport
settings preset Default
settings tab colors
wait 12
capture tutorials/display-colors.jpg popups
settings close
close-windows
plane 1 1 1
command Lattice Planes Settings
wait 12
capture tutorials/lattice-planes.jpg popups
close-windows
plane clear
direction 1 1 0
command Miller Directions Settings
wait 12
capture tutorials/miller-directions.jpg popups
close-windows
direction clear
command Polyhedral Settings
wait 12
capture tutorials/polyhedral-settings.jpg popups
close-windows
command Export Image
wait 12
capture tutorials/export-image.jpg popups
close-windows
command file open
browser-name cu_ni_alloy.cif
wait 12
capture tutorials/file-browser.jpg popups
close-windows
# Information and analysis.
close-all
open cu_ni_alloy.cif
reset-view
structure-info
wait 30
capture tutorials/structure-info.jpg popups
close-windows
close-all
open cu_host.cif
reset-view
select-atoms 13
command Atom Info
wait 20
capture tutorials/atom-info.jpg top
close-windows
pick-atom 13
context-menu
wait 12
capture tutorials/atom-context.jpg top
close-windows
clear-selection
close-all
open cu_ni_alloy.cif
reset-view
rdf open
try rdf run
wait 40
capture tutorials/rdf-analysis.jpg popups
close-windows
sro open
try sro run
wait 40
capture tutorials/sro-warren.jpg popups
sro tab 1
wait 12
capture tutorials/sro-rao.jpg popups
close-windows
# OVITO-style analyses: run in the scientific tool window, atoms coloured by the result.
close-all
open cu_polycrystal.cif
reset-view
tool ptm
run
colour-by-tool 1
wait 30
notify
wait 2
capture analysis/ptm.jpg full
tool grain-segmentation
run
try colour-by-tool 1
wait 30
notify
wait 2
capture analysis/grain-segmentation.jpg full
tool voronoi
run
try colour-by-tool 1
wait 30
notify
wait 2
capture analysis/voronoi.jpg full
close-windows
close-all
open cu_fcc.cif
reset-view
trajectory open cu_md.extxyz
wait 60
trajectory lines whole
wait 30
close-windows
wait 12
notify
wait 2
capture analysis/trajectory-lines.jpg full
close-all
open cu_sphere.xyz
reset-view
tool surface-mesh
run
toolwin surface on
wait 30
notify
wait 2
capture analysis/surface-mesh.jpg full
close-windows
# Electronic structure (the demonstration CHGCAR).
close-all
notify
dialog electronic open
dialog electronic load ../../../tmp/CHGCAR-electronic-demo
wait 120
capture electronic-volume.png tools
dialog electronic slice-arbitrary 0.5 0.5 0.5 1 1 1
wait 60
capture electronic-arbitrary.png tools
capture-done rust
quit
