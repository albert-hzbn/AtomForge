# The UI tour (the C++ ATOMFORGE_UI_TOUR, ui/UiTour.cpp): the main window,
# every menu and the main dialogs in both themes, as numbered screenshots in
# tmp/rust-tour, with the same names as the C++ tour's, to compare the two
# interfaces side by side. Run from the repository root:
#   ATOMFORGE_UI_SCRIPT=rust/tools/ui_tour.afscript rust/target/release/AtomForge
theme light
wait 12
screenshot tmp/rust-tour/01-welcome.png
open rust/tests/fixtures/tour/CuNi-L12.cif
step wrap
apply
close-windows
reset-view
notify
wait 12
screenshot tmp/rust-tour/02-main-window.png
menu File
wait 12
screenshot tmp/rust-tour/03-menu-File.png
close-windows
menu Edit
wait 12
screenshot tmp/rust-tour/04-menu-Edit.png
close-windows
menu Build
wait 12
screenshot tmp/rust-tour/05-menu-Build.png
close-windows
menu View
wait 12
screenshot tmp/rust-tour/06-menu-View.png
close-windows
menu Analysis
wait 12
screenshot tmp/rust-tour/07-menu-Analysis.png
close-windows
menu Settings
wait 12
screenshot tmp/rust-tour/08-menu-Settings.png
close-windows
menu Help
wait 12
screenshot tmp/rust-tour/09-menu-Help.png
close-windows
pipeline open
pipeline text replicate 2 1 1 | select-expression fz > 0.5 | assign-element Al | wrap
pipeline disable 4
wait 12
screenshot tmp/rust-tour/10-pipeline-panel.png
pipeline dock
wait 12
screenshot tmp/rust-tour/11-pipeline-docked.png
pipeline undock
wait 12
screenshot tmp/rust-tour/12-pipeline-undocked.png
