#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_KHR_shader_subgroup_ballot : require
#include "cull.glsl"
// With subgroup operations: one atomic per subgroup and level instead of one
// per instance (millions of instances otherwise queue on a few counters).
void main()
{
    uint i = gl_GlobalInvocationID.x;
    uint level = i < cull.counts.x ? classify(i) : ~0u;
    uint levels = cull.counts.y;
    for (uint l = 0u; l < levels; ++l)
    {
        uvec4 mine = subgroupBallot(level == l);
        uint count = subgroupBallotBitCount(mine);
        if (count == 0u) continue;
        uint base = 0u;
        if (subgroupElect()) base = atomicAdd(commands[cull.slots[l].x * 5u + 1u], count);
        base = subgroupBroadcastFirst(base);
        if (level == l) append(i, l, base + subgroupBallotExclusiveBitCount(mine));
    }
}
