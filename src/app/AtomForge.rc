// AtomForge.rc – Windows resource script
// Embeds the application manifest so Windows does not prompt for elevation
// and recognises the executable as a known, non-elevated application.

#include <winuser.h>

// GLFW looks for this exact resource name on Windows when assigning the
// running window icon; keep this in sync with the app icon asset.
GLFW_ICON ICON "..\\..\\assets\\icon\\atomforge.ico"

// Application icon for executable metadata and shortcuts.
IDI_APP_ICON ICON "..\\..\\assets\\icon\\atomforge.ico"

// RT_MANIFEST (ID 24), resource ID 1 = application manifest
1 RT_MANIFEST "AtomForge.manifest"
